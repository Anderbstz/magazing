# URL base de la API. Vacío en desarrollo: Vite reenvía /api al backend (ver vite.config.ts).
# En producción (Cloudflare Pages / Vercel): la URL pública de Render, sin barra final.
VITE_API_URL=

# Solo desarrollo: a dónde reenvía Vite las llamadas a /api.
VITE_DEV_API_TARGET=http://localhost:5261

# Solo desarrollo: datos simulados (MSW) para los módulos que el backend aún no expone.
# Pon "off" para usar únicamente la API real.
VITE_MOCKS=on
