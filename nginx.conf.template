server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Los archivos de /assets llevan hash en el nombre: se pueden cachear para siempre.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html no se cachea, para que cada deploy se vea al instante.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Service worker y manifest de la PWA: siempre se revisan, si no la app no detecta versiones nuevas.
    location ~ ^/(sw\.js|workbox-.*\.js|registerSW\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Fallback de SPA: cualquier ruta de React (/sales/pos, /inventory/stock…) sirve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
